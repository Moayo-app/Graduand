{
  // ─────────────────────────────────────────────────────────────────────────────
  // 호스팅 선언 — Cloudflare Workers Static Assets.
  //
  // ⭐⭐ **왜 저장소 루트인가.** `diagnosis/` 안에 두면 그 패키지의 공개 경계 가드가 드는
  //   「분모 완전성」(배달되는 파일이 분모에 있거나 **사유와 함께 제외**돼 있다)이 이 파일의
  //   열거를 요구하고, 호스팅 설정이 그 분모에 섞인다. 호스팅은 배달되는 산문이 아니다.
  //
  // ⛔ **형제 제품의 설정을 베끼지 않았다** — 스택이 다르고, 사본은 갈라진다.
  //
  // ⭐ **워커 스크립트가 없다**(`main` 0). 정적 자산만 서빙하므로 요청이 워커를 거치지 않고,
  //   그래서 「우리 코드가 도는 서버가 0」이 **참으로 남는다** — 그 문장은 `strings.ts` 와
  //   `main.ts` 가 언어 협상을 기각한 근거이기도 하다. 여기에 스크립트를 더하면 그 둘의
  //   주석이 함께 거짓이 된다.
  //
  // ⬜ **커스텀 도메인은 아직 붙지 않았다** — `graduand.dev` 에 A·AAAA·CNAME 가 0 건이다
  //   (2026-10-27 실측). 붙는 날 저작권의 최초 발행 연도가 그 해로 박힌다
  //   (`diagnosis/src/publisher.ts` — 근거 없이 적지 않는다).
  // ─────────────────────────────────────────────────────────────────────────────
  "name": "graduand",
  "compatibility_date": "2026-10-27",

  "assets": {
    // ⭐ **이 디렉터리가 곧 사이트다** — 생성기가 통째로 짓는다(문서 둘 · 화면 · 브랜드 자산 ·
    //   색인 선언 셋). `tsc` 의 산출도 같은 자리로 내려앉아 `/diagnosis/src/main.js` 가 선다.
    //   ⛔ 패키지 폴더를 통째로 서빙하지 않는다 — 그러면 `src/`·`package.json` 까지 나간다.
    "directory": "./diagnosis/dist",

    // 문서의 주소가 `/ko/` · `/en/` 이라 끝 슬래시를 그대로 받는다.
    "html_handling": "auto-trailing-slash",

    // ⬜ 404 페이지가 아직 없다 — 있는 척하지 않는다(`"404-page"` 는 그 파일을 요구한다).
    "not_found_handling": "none"
  }
}
