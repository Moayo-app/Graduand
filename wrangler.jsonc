{
  // ─────────────────────────────────────────────────────────────────────────────
  // 호스팅 선언 — Cloudflare Workers Static Assets.
  //
  // ⭐⭐ **왜 작업장 루트인가 — 그리고 이 파일은 배달된다.**
  //   ⑴ `diagnosis/` 안에 두면 그 패키지의 공개 경계 가드가 드는 「분모 완전성」(배달되는
  //      파일이 분모에 있거나 **사유와 함께 제외**돼 있다)이 이 파일의 열거를 요구하고,
  //      호스팅 설정이 그 분모에 섞인다.
  //   ⑵ 그런데 **배포가 일어나는 자리는 공개 저장소**다. 그래서 정본은 여기이고, 공개 범위
  //      선언이 이 경로를 `origin: workshop` 으로 들어 **배달이 나른다** — 받는 쪽에서 손으로
  //      고치지 않는다(다음 배달이 되돌린다).
  //   ⭐ 사유는 **가드가 선언 옆에 서야 한다**는 것이다: 아래 값들을 무는 단정이 이 저장소에
  //      있고, 정본을 옮기면 그 가드를 다시 짓거나 CI 가 다른 저장소를 읽어야 한다.
  //
  // ⛔ **형제 제품의 설정을 베끼지 않았다** — 스택이 다르고, 사본은 갈라진다.
  //
  // ⭐ **이 배포에 워커 스크립트가 없다**(`main` 0). 정적 자산만 서빙하므로 **페이지 요청이
  //   워커를 거치지 않고**, 그 사실이 `strings.ts` 와 `main.ts` 가 언어 협상을 기각한
  //   근거다. 여기에 스크립트를 더하면 그 둘의 주석이 함께 거짓이 된다.
  //
  // ⚠️⚠️ **「이 배포에」가 보태진 것이 결정이다.** 전에는 「우리 코드가 도는 서버가 0」이라고
  //   적었고, 그 한 문장이 셋을 한꺼번에 지고 있었다: ⑴ 이 배포에 스크립트가 없다
  //   ⑵ 그래서 협상이 설 자리가 없다 ⑶ 판정과 그 결과가 우리 서버를 지나지 않는다.
  //   과금 웹훅이 **따로** 서면서(`webhook/wrangler.jsonc`) ⑴ 과 ⑵ 는 그대로 참이고 ⑶ 도
  //   참이지만, **제품 전체로 읽은 그 문장**은 거짓이 됐다. ⇒ 문면을 좁힌다.
  // ⛔ 그 워커를 이 파일에 넣지 않는다 — 넣으면 ⑴ 과 ⑵ 가 함께 거짓이 되고, 가드 둘이
  //   즉시 운다(이 저장소의 `hosting.test.ts` 와 그쪽 패키지의 것).
  //
  // ⬜ **커스텀 도메인은 아직 붙지 않았다** — `graduand.dev` 에 A·AAAA·CNAME 가 0 건이다
  //   (2026-10-28 실측, 공개 리졸버 둘에서 같은 수). ⭐ 그런데 **영역은 이미 이 벤더의
  //   네임서버에 있다**(같은 실측에서 NS 2 건) — 그래서 사람이 하는 일은 「A 레코드 입력」이
  //   아니라 **부착**이다: 1차 문서가 커스텀 도메인을 축자로 「DNS 설정을 바꾸지 않아도
  //   된다」고 적는다. ⬜ 배포가 그 레코드를 **만드는** 것인지까지는 1차 문서가 말하지 않는다 —
  //   붙는 날 `dig` 한 번이 그 칸을 닫는다. ⚠️ 어느 쪽이든 **부착이 곧 컷오버다.**
  // ─────────────────────────────────────────────────────────────────────────────
  "name": "graduand",
  "compatibility_date": "2026-10-27",

  // ⛔ **`workers.dev` 주소를 열지 않는다.** 열면 `graduand-<계정>.workers.dev` 로 사이트가
  //   **지금 공개된다** — 「부착이 곧 컷오버」라고 정해 둔 그 행위가 커스텀 도메인 없이
  //   일어나는 셈이고, 링크 여섯이 404 인 화면이 우리 이름을 걸고 선다.
  // ⚠️ 그리고 그 주소는 색인된다 — 되돌려도 캐시와 색인은 남는다.
  // ⭐ `routes` 를 비워 둔 것과 **같은 하나의 결정**이다: 공개는 공개 전환에서만 일어난다.
  "workers_dev": false,

  "assets": {
    // ⭐ **이 디렉터리가 곧 사이트다** — 생성기가 통째로 짓는다(문서 둘 · 화면 · 브랜드 자산 ·
    //   색인 선언 셋). `tsc` 의 산출도 같은 자리로 내려앉아 `/diagnosis/src/main.js` 가 선다.
    //   ⛔ 패키지 폴더를 통째로 서빙하지 않는다 — 그러면 `src/`·`package.json` 까지 나간다.
    "directory": "./diagnosis/dist",

    // 문서의 주소가 `/ko/` · `/en/` 이라 끝 슬래시를 그대로 받는다.
    "html_handling": "auto-trailing-slash",

    // ⬜ 404 페이지가 아직 없다 — 있는 척하지 않는다(`"404-page"` 는 그 파일을 요구한다).
    "not_found_handling": "none"
  },

  // ⭕⭕ **`routes` 가 섰다 — 이 줄이 컷오버다.**
  //   ⚠️ 이 선언을 집행하는 배포가 커스텀 도메인을 붙이고, 그 순간 사이트가 **공개된다.**
  //   그래서 이 칸은 혼자 서지 않는다: 저작권의 최초 발행 연도 · 정책 셋의 시행일 · 그
  //   각각의 근거(`diagnosis/src/publisher.ts` 의 네 칸)가 **함께** 서야 가드가 초록이다
  //   (`diagnosis/src/hosting.test.ts` 의 묶음 판정). 하나만 넣으면 빨갛다.
  //
  //   ⛔ 호스트를 **여기서 고르지 않았다** — 가드가 발행 출처 상수(`diagnosis/src/site.ts`)
  //   에서 유도해 이 값과 대조한다. 두 자리에 적힌 것이 갈라지면 색인 선언은 한 주소를
  //   가리키고 서빙은 다른 주소에서 도는데, 그 어긋남은 화면에 아무 표시도 남기지 않는다.
  //   ⇒ 이 문자열을 바꾸려면 그 상수를 바꾼다(그러면 이 줄이 따라온다).
  //
  //   ⭐ `custom_domain: true` 라야 **그 영역의 레코드로** 선다 — 빠뜨리면 경로 패턴으로
  //   읽혀 부착이 일어나지 않고, 그 실패는 빌드에서 아무 표시도 남기지 않는다(가드가 문다).
  //
  // ⬜ **맨 도메인 하나다** — `www` 는 선언이 든 적이 없고 레코드도 0 건이다. 붙이려면 그
  //   주소로 오는 요청을 어디로 보낼지가 **먼저 결정**이고, 그 결정이 없는 동안 적지 않는다.
  //
  // ⛔ **창구에 주는 돌아오는 주소 둘은 기계가 볼 수 없다** — 창구의 설정은 이 저장소 밖이고
  //   가드는 발행본의 바이트만 문다. 그 하나는 사람이 같은 창에서 본다.
  "routes": [{ "pattern": "graduand.dev", "custom_domain": true }]
}
